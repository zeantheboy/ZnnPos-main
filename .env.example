# Database runtime utama: PostgreSQL lokal tempat POS menyimpan data terlebih dahulu.
# Backend membaca LOCAL_DATABASE_URL lebih dulu.
LOCAL_DATABASE_URL=postgresql://imac@localhost:5432/znnpos

# Ambil dari Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Connection string PostgreSQL Supabase untuk mengirim antrean lokal ke cloud.
# Gunakan connection pooling Supabase jika tersedia; jangan commit nilainya.
REMOTE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Fallback runtime/deployment jika LOCAL_DATABASE_URL tidak diisi.
# Jangan isi ini di komputer lokal jika ingin tetap local-first.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Hanya untuk migrasi satu kali dari SQLite lama ke PostgreSQL.
# TARGET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/znnpos
# SOURCE_DB=/path/ke/pos.db
